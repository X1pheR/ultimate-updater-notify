# ntfy topic URL. Keep deployment-specific values outside the public product repository.
# Prefer HTTPS whenever the publisher crosses an untrusted network boundary.
NTFY_URL="https://ntfy.example.com/ultimate-updater"

# Root-readable file containing only the ntfy access token. The notifier sends
# it using native ntfy Bearer authentication and never places it in curl argv.
NTFY_TOKEN_FILE="/etc/ultimate-updater-notify/ntfy-token"

NTFY_TITLE_PREFIX="Ultimate Updater"

# Optional: publish successful systemd-scheduled checks to a Gatus external endpoint.
# Leave both values empty to disable heartbeat delivery.
GATUS_HEARTBEAT_URL=""
GATUS_HEARTBEAT_TOKEN_FILE=""

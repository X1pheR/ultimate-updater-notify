#!/usr/bin/env bash
set -Eeuo pipefail

APP_NAME="ultimate-updater-notify"
SUPPORTED_UPDATER_VERSION="5.1.3"
SUPPORTED_STATUS_SCHEMA_VERSION="1"
CONFIG_FILE="${UUN_CONFIG_FILE:-/etc/ultimate-updater-notify/config}"
STATE_DIR="${UUN_STATE_DIR:-/var/lib/ultimate-updater-notify}"
UPDATER_DIR="${UUN_UPDATER_DIR:-/etc/ultimate-updater}"
UPDATER_CONFIG="${UUN_UPDATER_CONFIG:-${UPDATER_DIR}/update.conf}"
UPDATER_LOG="${UUN_UPDATER_LOG:-/var/log/ultimate-updater.log}"
UPDATER_ENTRYPOINT="${UUN_UPDATER_ENTRYPOINT:-${UPDATER_DIR}/update.sh}"
UPDATER_CHECK_SCRIPT="${UUN_UPDATER_CHECK_SCRIPT:-${UPDATER_DIR}/check-updates.sh}"
UPDATER_STATUS_MODEL="${UUN_UPDATER_STATUS_MODEL:-${UPDATER_DIR}/status-model.sh}"
UPDATER_TARGET_RUNTIME="${UUN_UPDATER_TARGET_RUNTIME:-${UPDATER_DIR}/target-runtime.sh}"
UPDATER_STATUS_FILE="${UUN_UPDATER_STATUS_FILE:-${UPDATER_DIR}/status.json}"
SYSTEMCTL="${UUN_SYSTEMCTL:-systemctl}"
CRONTAB="${UUN_CRONTAB:-crontab}"
SYSTEM_CRONTAB="${UUN_SYSTEM_CRONTAB:-/etc/crontab}"
CRON_D_DIR="${UUN_CRON_D_DIR:-/etc/cron.d}"
TIMEOUT_BIN="${UUN_TIMEOUT:-timeout}"
UPSTREAM_CHECK_TIMEOUT_SECONDS="${UUN_UPSTREAM_CHECK_TIMEOUT_SECONDS:-540}"
MANUAL_DEDUPE_SECONDS="${UUN_MANUAL_DEDUPE_SECONDS:-90}"
NTFY_MESSAGE_MAX_BYTES="${UUN_NTFY_MESSAGE_MAX_BYTES:-3500}"

log() {
  printf '%s: %s\n' "$APP_NAME" "$*" >&2
}

die() {
  log "$*"
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

read_updater_value() {
  local key=$1
  awk -F'"' -v key="$key" '$0 ~ "^" key "=" { print $2; exit }' "$UPDATER_CONFIG"
}

load_config() {
  [[ -r "$CONFIG_FILE" ]] || die "configuration file is not readable: $CONFIG_FILE"
  # shellcheck disable=SC1090
  . "$CONFIG_FILE"

  : "${NTFY_URL:?NTFY_URL must be configured}"
  : "${NTFY_TOKEN_FILE:?NTFY_TOKEN_FILE must be configured}"
  NTFY_TITLE_PREFIX="${NTFY_TITLE_PREFIX:-Ultimate Updater}"

  [[ -r "$NTFY_TOKEN_FILE" ]] || die "ntfy token file is not readable: $NTFY_TOKEN_FILE"
  require_command curl
}

run_upstream_check_bounded() {
  "$TIMEOUT_BIN" --signal=TERM --kill-after=10s "${UPSTREAM_CHECK_TIMEOUT_SECONDS}s" "$@"
}

ensure_state_dir() {
  install -d -m 0700 "$STATE_DIR"
}

atomic_write() {
  local path=$1
  local value=$2
  local tmp
  tmp=$(mktemp "${STATE_DIR}/.tmp.XXXXXX")
  printf '%s\n' "$value" >"$tmp"
  chmod 0600 "$tmp"
  mv -f "$tmp" "$path"
}

state_read() {
  local path=$1
  [[ -r "$path" ]] || return 0
  cat "$path"
}

limit_ntfy_message() {
  local message=$1
  local max_bytes=$NTFY_MESSAGE_MAX_BYTES
  local suffix=$'\n\n[message truncated]'
  local output=""
  local line
  local candidate
  local bytes

  [[ "$max_bytes" =~ ^[0-9]+$ ]] || die "UUN_NTFY_MESSAGE_MAX_BYTES must be an integer"
  ((max_bytes >= 256 && max_bytes <= 4096)) || die "UUN_NTFY_MESSAGE_MAX_BYTES must be between 256 and 4096"

  bytes=$(printf '%s' "$message" | wc -c)
  if ((bytes <= max_bytes)); then
    printf '%s' "$message"
    return 0
  fi

  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ -n "$output" ]]; then
      candidate="${output}"$'\n'"${line}"
    else
      candidate=$line
    fi
    bytes=$(printf '%s' "${candidate}${suffix}" | wc -c)
    if ((bytes > max_bytes)); then
      break
    fi
    output=$candidate
  done <<<"$message"

  if [[ -z "$output" ]]; then
    output="[message content omitted because the first line exceeds the delivery limit]"
  else
    output+="$suffix"
  fi
  printf '%s' "$output"
}

send_ntfy() {
  local title=$1
  local tags=$2
  local message=$3
  local markdown=${4:-false}
  local token

  load_config
  token=$(<"$NTFY_TOKEN_FILE")
  [[ -n "$token" ]] || die "ntfy token file is empty"
  message=$(limit_ntfy_message "$message")

  # Keep the bearer token out of argv. curl reads all headers from stdin.
  {
    printf 'Authorization: Bearer %s\n' "$token"
    printf 'Title: %s\n' "${NTFY_TITLE_PREFIX}: ${title}"
    [[ -n "$tags" ]] && printf 'Tags: %s\n' "$tags"
    if [[ "$markdown" == "true" ]]; then
      printf 'Markdown: yes\n'
    fi
  } | curl \
    --fail \
    --silent \
    --show-error \
    --connect-timeout 10 \
    --max-time 30 \
    --header @- \
    --data-binary "$message" \
    "$NTFY_URL" >/dev/null
}

send_gatus_heartbeat() {
  local token

  [[ "${UUN_SCHEDULED_RUN:-false}" == "true" ]] || return 0
  load_config
  GATUS_HEARTBEAT_URL="${GATUS_HEARTBEAT_URL:-}"
  GATUS_HEARTBEAT_TOKEN_FILE="${GATUS_HEARTBEAT_TOKEN_FILE:-}"
  [[ -n "$GATUS_HEARTBEAT_URL" ]] || return 0
  [[ -n "$GATUS_HEARTBEAT_TOKEN_FILE" ]] || die "GATUS_HEARTBEAT_TOKEN_FILE must be configured when GATUS_HEARTBEAT_URL is set"
  [[ -r "$GATUS_HEARTBEAT_TOKEN_FILE" ]] || die "Gatus heartbeat token file is not readable: $GATUS_HEARTBEAT_TOKEN_FILE"
  token=$(<"$GATUS_HEARTBEAT_TOKEN_FILE")
  [[ -n "$token" ]] || die "Gatus heartbeat token file is empty"

  printf 'Authorization: Bearer %s\n' "$token" | curl \
    --fail \
    --silent \
    --show-error \
    --connect-timeout 10 \
    --max-time 30 \
    --header @- \
    --request POST \
    "${GATUS_HEARTBEAT_URL}?success=true" >/dev/null
}

sanitize_text() {
  sed -r 's/\x1B\[([0-9]{1,3}(;[0-9]{1,3})*)?[mGK]//g'
}

hash_text() {
  sha256sum | awk '{print $1}'
}

is_updater_check_cron() {
  local line=$1
  [[ "$line" =~ (^|[[:space:]])(/usr/local/sbin/)?update[[:space:]]+-check([[:space:]]|$) ]] ||
    [[ "$line" =~ (^|[[:space:]])/etc/ultimate-updater/update\.sh[[:space:]]+-check([[:space:]]|$) ]] ||
    [[ "$line" =~ (^|[[:space:]])/etc/ultimate-updater/check-updates\.sh([[:space:]]|$) ]]
}

validate_cron_file() {
  local source=$1
  local line

  [[ -r "$source" ]] || die "cron source is not readable: $source"
  while IFS= read -r line || [[ -n "$line" ]]; do
    if is_updater_check_cron "$line"; then
      die "Ultimate Updater automatic check cron is present in $source; companion scheduling must remain the only automatic check path"
    fi
  done <"$source"
}

validate_system_cron_sources() {
  local cron_file

  validate_cron_file "$SYSTEM_CRONTAB"
  [[ -d "$CRON_D_DIR" ]] || return 0
  for cron_file in "$CRON_D_DIR"/*; do
    [[ -f "$cron_file" ]] || continue
    validate_cron_file "$cron_file"
  done
}

read_updater_version() {
  awk -F'"' '/^VERSION="/ { print $2; exit }' "$UPDATER_ENTRYPOINT"
}

upstream_fingerprint() {
  {
    sha256sum "$UPDATER_ENTRYPOINT" | awk '{print $1}'
    sha256sum "$UPDATER_CHECK_SCRIPT" | awk '{print $1}'
    sha256sum "$UPDATER_STATUS_MODEL" | awk '{print $1}'
    sha256sum "$UPDATER_TARGET_RUNTIME" | awk '{print $1}'
    sha256sum "${UPDATER_DIR}/tag-filter.sh" | awk '{print $1}'
  } | hash_text
}

validate_upstream_check_interface() {
  [[ -r "$UPDATER_CHECK_SCRIPT" ]] || die "Ultimate Updater check-updates.sh is not readable"
  [[ -r "$UPDATER_STATUS_MODEL" ]] || die "Ultimate Updater status-model.sh is not readable"
  [[ -r "$UPDATER_TARGET_RUNTIME" ]] || die "Ultimate Updater target-runtime.sh is not readable"

  grep -Fq 'UU_JOB_SOURCE' "$UPDATER_CHECK_SCRIPT" || die "Ultimate Updater check interface no longer exposes initial-inventory mode"
  grep -Fq 'initial-inventory' "$UPDATER_CHECK_SCRIPT" || die "Ultimate Updater check interface no longer exposes initial-inventory mode"
  grep -Fq 'UU_DEFER_NOTIFICATION' "$UPDATER_CHECK_SCRIPT" || die "Ultimate Updater check interface no longer supports deferred notifications"
  grep -Fq 'HOST_KERNEL_REBOOT_REQUIRED' "$UPDATER_CHECK_SCRIPT" || die "Ultimate Updater check interface no longer exposes Proxmox kernel reboot detection"
  grep -Fq 'normal_updates' "$UPDATER_STATUS_MODEL" || die "Ultimate Updater status model no longer exposes normal update counts"
  grep -Fq 'security_updates' "$UPDATER_STATUS_MODEL" || die "Ultimate Updater status model no longer exposes security update counts"
  grep -Fq 'reboot_required' "$UPDATER_STATUS_MODEL" || die "Ultimate Updater status model no longer exposes reboot state"
  if ! (
    set +u
    # These names are consumed by the dynamically sourced Ultimate Updater
    # status model; ShellCheck cannot see those indirect references.
    # shellcheck disable=SC2034
    LOCAL_FILES="$UPDATER_DIR"
    # shellcheck disable=SC2034
    STATUS_MODEL_FILE="$UPDATER_STATUS_FILE"
    # shellcheck disable=SC1090
    . "$UPDATER_STATUS_MODEL"
    declare -F STATUS_MODEL_RENDER_NOTIFICATION >/dev/null 2>&1
  ); then
    die "Ultimate Updater status model no longer exposes STATUS_MODEL_RENDER_NOTIFICATION"
  fi
}

validate_companion_units() {
  local unit
  for unit in "$APP_NAME-check.timer" "$APP_NAME-manual.path"; do
    if ! "$SYSTEMCTL" is-enabled "$unit" >/dev/null 2>&1; then
      die "companion systemd unit is not enabled: $unit"
    fi
    if ! "$SYSTEMCTL" is-active "$unit" >/dev/null 2>&1; then
      die "companion systemd unit is not active: $unit"
    fi
  done
}

validate_tag_helper() (
  local ONLY
  local EXCLUDED

  [[ -r "$UPDATER_CONFIG" ]] || die "Ultimate Updater configuration is not readable: $UPDATER_CONFIG"
  [[ -r "${UPDATER_DIR}/tag-filter.sh" ]] || die "Ultimate Updater tag-filter.sh is not readable"
  # The sourced upstream helper resolves these variables indirectly from the
  # variable names passed to apply_only_exclude_tags.
  # shellcheck disable=SC2034
  ONLY=$(read_updater_value ONLY_UPDATE_CHECK || true)
  # shellcheck disable=SC2034
  EXCLUDED=$(read_updater_value EXCLUDE_UPDATE_CHECK || true)

  # Upstream's helper is not guaranteed to be nounset-safe. Keep the relaxed
  # shell option inside this isolated compatibility probe only.
  set +u
  # shellcheck disable=SC1091
  . "${UPDATER_DIR}/tag-filter.sh"
  declare -F apply_only_exclude_tags >/dev/null 2>&1 || die "Ultimate Updater tag-filter.sh no longer exposes apply_only_exclude_tags"
  apply_only_exclude_tags ONLY EXCLUDED || die "Ultimate Updater tag-filter.sh compatibility probe failed"
)

compatibility_probe() {
  local line
  local version
  local fingerprint
  local configured_log

  [[ -r "$UPDATER_ENTRYPOINT" ]] || die "Ultimate Updater entrypoint is not readable: $UPDATER_ENTRYPOINT"
  require_command sha256sum
  validate_upstream_check_interface || return 1
  require_command "$CRONTAB"
  version=$(read_updater_version)
  [[ -n "$version" ]] || die "Ultimate Updater version marker is missing or incompatible"
  [[ "$version" == "$SUPPORTED_UPDATER_VERSION" ]] || die "unsupported Ultimate Updater version: $version; this notifier release requires $SUPPORTED_UPDATER_VERSION"
  configured_log=$(read_updater_value LOG_FILE || true)
  [[ -n "$configured_log" ]] || die "Ultimate Updater LOG_FILE is missing from $UPDATER_CONFIG"
  [[ "$configured_log" == "$UPDATER_LOG" ]] || die "Ultimate Updater LOG_FILE changed; expected observer path $UPDATER_LOG"
  validate_tag_helper || return 1
  validate_companion_units || return 1
  while IFS= read -r line || [[ -n "$line" ]]; do
    if is_updater_check_cron "$line"; then
      die "Ultimate Updater automatic check cron is present; companion scheduling must remain the only automatic check path"
    fi
  done < <("$CRONTAB" -l 2>/dev/null || true)
  validate_system_cron_sources || return 1

  fingerprint=$(upstream_fingerprint)
  printf '%s|%s\n' "$version" "$fingerprint"
}

process_health_failure() {
  local error_text=$1
  local previous_status
  local previous_hash
  local current_hash

  ensure_state_dir
  previous_status=$(state_read "${STATE_DIR}/health-status")
  previous_hash=$(state_read "${STATE_DIR}/health-hash")
  error_text=$(printf '%s\n' "$error_text" | sanitize_text | tail -20)
  [[ -n "$error_text" ]] || error_text="Unknown compatibility-health failure"
  current_hash=$(printf '%s\n' "$error_text" | hash_text)

  if [[ "$previous_status" != "failure" || "$previous_hash" != "$current_hash" ]]; then
    if ! send_ntfy "Compatibility check failed" "warning" "$error_text"; then
      log "failed to send ntfy compatibility failure notification"
      return 1
    fi
  fi
  atomic_write "${STATE_DIR}/health-status" "failure"
  atomic_write "${STATE_DIR}/health-hash" "$current_hash"
}

process_health_success() {
  local version=$1
  local fingerprint=$2
  local previous_status
  local accepted_fingerprint

  ensure_state_dir
  previous_status=$(state_read "${STATE_DIR}/health-status")
  accepted_fingerprint=$(state_read "${STATE_DIR}/upstream-safety-fingerprint")

  # v0.5+ delegates safety-critical collection to Ultimate Updater 5.1's
  # initial-inventory/status interface. Establish the accepted source
  # fingerprint once for this release, then fail closed on any later source
  # drift until a new companion release explicitly accepts that boundary.
  if [[ -n "$accepted_fingerprint" && "$accepted_fingerprint" != "$fingerprint" ]]; then
    process_health_failure "Ultimate Updater safety-critical interface changed after acceptance. Automatic checks are blocked until this notifier release is updated for the changed upstream source."
    return 1
  fi

  if [[ "$previous_status" == "failure" ]]; then
    if ! send_ntfy "Compatibility check recovered" "white_check_mark" "Ultimate Updater compatibility checks are succeeding again. Current version: $version"; then
      log "failed to send ntfy compatibility recovery notification"
      return 1
    fi
  fi

  atomic_write "${STATE_DIR}/health-status" "healthy"
  atomic_write "${STATE_DIR}/health-hash" ""
  if [[ -z "$accepted_fingerprint" ]]; then
    atomic_write "${STATE_DIR}/upstream-safety-fingerprint" "$fingerprint"
  fi
  atomic_write "${STATE_DIR}/upstream-version" "$version"
}

run_health() {
  local output_file
  local error_file
  local probe_output
  local version
  local fingerprint
  local rc

  output_file=$(mktemp)
  error_file=$(mktemp)
  set +e
  ( compatibility_probe ) >"$output_file" 2>"$error_file"
  rc=$?
  set -e

  if [[ "$rc" -ne 0 ]]; then
    if ! process_health_failure "$(cat "$error_file")"; then
      rm -f "$output_file" "$error_file"
      return 1
    fi
    rm -f "$output_file" "$error_file"
    return "$rc"
  fi

  probe_output=$(cat "$output_file")
  rm -f "$output_file" "$error_file"
  version=${probe_output%%|*}
  fingerprint=${probe_output#*|}
  process_health_success "$version" "$fingerprint"
}

validate_upstream_status_schema() {
  require_command python3
  python3 - "$UPDATER_STATUS_FILE" "$SUPPORTED_STATUS_SCHEMA_VERSION" <<'PYJSON'
import json
import sys

path = sys.argv[1]
expected = int(sys.argv[2])
try:
    with open(path, encoding="utf-8") as handle:
        payload = json.load(handle)
except (OSError, json.JSONDecodeError) as exc:
    raise SystemExit(f"Ultimate Updater status schema validation failed: {exc}")

if not isinstance(payload, dict):
    raise SystemExit("Ultimate Updater status schema validation failed: root must be an object")
actual = payload.get("schema_version")
if type(actual) is not int or actual != expected:
    raise SystemExit(
        f"Ultimate Updater status schema_version mismatch: expected {expected}, observed {actual!r}"
    )
if not isinstance(payload.get("targets"), list):
    raise SystemExit("Ultimate Updater status schema validation failed: targets must be a list")
PYJSON
}

render_upstream_status() (
  set +u
  # These names are consumed by the dynamically sourced Ultimate Updater
  # status model; ShellCheck cannot see those indirect references.
  # shellcheck disable=SC2034
  LOCAL_FILES="$UPDATER_DIR"
  # shellcheck disable=SC2034
  STATUS_MODEL_FILE="$UPDATER_STATUS_FILE"
  # shellcheck disable=SC1090
  . "$UPDATER_STATUS_MODEL"
  declare -F STATUS_MODEL_RENDER_NOTIFICATION >/dev/null 2>&1 || return 1
  STATUS_MODEL_RENDER_NOTIFICATION "$UPDATER_STATUS_FILE" check
)

collect_upstream_updates() {
  local output_file
  local error_file
  local rc

  require_command python3
  require_command "$TIMEOUT_BIN"
  ensure_state_dir
  output_file=$(mktemp "${STATE_DIR}/.upstream-check.stdout.XXXXXX")
  error_file=$(mktemp "${STATE_DIR}/.upstream-check.stderr.XXXXXX")

  set +e
  run_upstream_check_bounded env \
    UU_JOB_SOURCE=initial-inventory \
    UU_DEFER_NOTIFICATION=true \
    TAG_OUTPUT=false \
    STATUS_MODEL_FILE="$UPDATER_STATUS_FILE" \
    "$UPDATER_CHECK_SCRIPT" >"$output_file" 2>"$error_file"
  rc=$?
  set -e

  if [[ "$rc" -ne 0 ]]; then
    if [[ -s "$error_file" ]]; then
      cat "$error_file" >&2
    elif [[ -s "$output_file" ]]; then
      cat "$output_file" >&2
    else
      printf 'Ultimate Updater initial-inventory check failed with exit code %s\n' "$rc" >&2
    fi
    rm -f "$output_file" "$error_file"
    return "$rc"
  fi
  rm -f "$output_file" "$error_file"
  [[ -s "$UPDATER_STATUS_FILE" ]] || die "Ultimate Updater did not produce status output: $UPDATER_STATUS_FILE"
  validate_upstream_status_schema || return 1
  render_upstream_status
}

process_check_success() {
  local message=$1
  local previous_status
  local previous_hash
  local current_hash

  ensure_state_dir
  previous_status=$(state_read "${STATE_DIR}/check-status")
  previous_hash=$(state_read "${STATE_DIR}/check-hash")

  if [[ -n "$message" ]]; then
    current_hash=$(printf '%s\n' "$message" | hash_text)
    if [[ "$previous_status" == "failure" ]]; then
      if ! send_ntfy "Update check recovered" "white_check_mark" "Automatic update checks are succeeding again."; then
        log "failed to send ntfy recovery notification"
        return 1
      fi
    fi
    if [[ "$previous_status" != "updates" ]]; then
      if ! send_ntfy "Updates available" "package" "$message"; then
        log "failed to send ntfy updates-available notification"
        return 1
      fi
    elif [[ "$previous_hash" != "$current_hash" ]]; then
      if ! send_ntfy "Available updates changed" "package" "$message"; then
        log "failed to send ntfy changed-updates notification"
        return 1
      fi
    fi
    atomic_write "${STATE_DIR}/check-status" "updates"
    atomic_write "${STATE_DIR}/check-hash" "$current_hash"
  else
    if [[ "$previous_status" == "failure" ]]; then
      if ! send_ntfy "Update check recovered" "white_check_mark" "Automatic update checks are succeeding again. No updates or reboot-required states are currently reported."; then
        log "failed to send ntfy recovery notification"
        return 1
      fi
    elif [[ "$previous_status" == "updates" ]]; then
      if ! send_ntfy "Updates cleared" "white_check_mark" "Previously reported package updates or reboot-required states are no longer present."; then
        log "failed to send ntfy updates-cleared notification"
        return 1
      fi
    fi
    atomic_write "${STATE_DIR}/check-status" "clear"
    atomic_write "${STATE_DIR}/check-hash" ""
  fi
}

process_check_failure() {
  local error_text=$1
  local previous_status
  local previous_hash
  local current_hash

  ensure_state_dir
  previous_status=$(state_read "${STATE_DIR}/check-status")
  previous_hash=$(state_read "${STATE_DIR}/check-hash")
  error_text=$(printf '%s\n' "$error_text" | sanitize_text | tail -20)
  [[ -n "$error_text" ]] || error_text="Unknown update-check failure"
  current_hash=$(printf '%s\n' "$error_text" | hash_text)

  if [[ "$previous_status" != "failure" || "$previous_hash" != "$current_hash" ]]; then
    if ! send_ntfy "Update check failed" "warning" "$error_text"; then
      log "failed to send ntfy failure notification"
      return 1
    fi
  fi
  atomic_write "${STATE_DIR}/check-status" "failure"
  atomic_write "${STATE_DIR}/check-hash" "$current_hash"
}

run_check() {
  local output_file
  local error_file
  local normalized
  local rc

  if ! run_health; then
    return 1
  fi

  output_file=$(mktemp)
  error_file=$(mktemp)

  set +e
  ( collect_upstream_updates ) >"$output_file" 2>"$error_file"
  rc=$?
  set -e

  if [[ "$rc" -ne 0 ]]; then
    if ! process_check_failure "$(cat "$error_file")"; then
      rm -f "$output_file" "$error_file"
      return 1
    fi
    rm -f "$output_file" "$error_file"
    return "$rc"
  fi

  normalized=$(cat "$output_file")
  rm -f "$output_file" "$error_file"
  local upstream_state upstream_body
  upstream_state=${normalized%%$'\n'*}
  upstream_state=${upstream_state#STATE=}
  if [[ "$normalized" == *$'\n'* ]]; then
    upstream_body=${normalized#*$'\n'}
  else
    upstream_body=""
  fi
  case "$upstream_state" in
    updates)
      if ! process_check_success "$upstream_body"; then
        return 1
      fi
      ;;
    current|empty)
      if ! process_check_success ""; then
        return 1
      fi
      ;;
    issues)
      if ! process_check_failure "$upstream_body"; then
        return 1
      fi
      return 1
      ;;
    *)
      if ! process_check_failure "Ultimate Updater returned an unsupported notification state: ${upstream_state:-missing}"; then
        return 1
      fi
      return 1
      ;;
  esac
  local heartbeat_error
  if ! heartbeat_error=$(send_gatus_heartbeat 2>&1); then
    if ! process_check_failure "Gatus heartbeat delivery failed${heartbeat_error:+: $heartbeat_error}"; then
      return 1
    fi
    return 1
  fi
}

manual_run_marker_present() {
  local clean_log=$1
  grep -Eq 'Updating Host|Update only LXC/VM|--- PVE UPDATE ---|Updating LXC|Updating VM' <<<"$clean_log"
}

manual_target_details() {
  local clean_log=$1
  grep -E 'Updating Host|Update only LXC/VM|--- PVE UPDATE ---|Updating LXC|Updating VM' <<<"$clean_log" | awk '!seen[$0]++'
}

manual_failure_details() {
  local error_log
  local line
  local line_bytes
  error_log=$(read_updater_value ERROR_LOG_FILE || true)
  if [[ -n "$error_log" && -r "$error_log" && -s "$error_log" ]]; then
    printf '\n\nRecent Ultimate Updater error details:\n'
    while IFS= read -r line || [[ -n "$line" ]]; do
      line_bytes=$(printf '%s' "$line" | wc -c)
      if ((line_bytes > 512)); then
        printf '[oversized error detail omitted: %d bytes]\n' "$line_bytes"
      else
        printf '%s\n' "$line"
      fi
    done < <(tail -30 "$error_log" | sanitize_text)
  fi
}

observe_manual() {
  local clean_log
  local outcome
  local title
  local tags
  local details
  local signature
  local now
  local previous_signature
  local previous_time

  [[ -r "$UPDATER_LOG" ]] || return 0
  ensure_state_dir
  clean_log=$(sanitize_text <"$UPDATER_LOG")

  if ! manual_run_marker_present "$clean_log"; then
    return 0
  fi

  if grep -q 'Finished, with errors\.' <<<"$clean_log"; then
    outcome="with-errors"
    title="Manual update finished with errors"
    tags="warning"
  elif grep -q 'Error during update --- Exit Code:' <<<"$clean_log"; then
    outcome="failure"
    title="Manual update failed"
    tags="x"
  elif grep -q 'Finished, all updates done\.' <<<"$clean_log"; then
    outcome="success"
    title="Manual update succeeded"
    tags="white_check_mark"
  else
    return 0
  fi

  details=$(manual_target_details "$clean_log")
  if [[ -n "$details" ]]; then
    details="Targets:
${details}"
  else
    details="Targets: unavailable"
  fi
  if [[ "$outcome" != "success" ]]; then
    details+=$(manual_failure_details)
  fi

  # Upstream rewrites the log during cleanup after printing the terminal marker.
  # Hash only stable run/outcome markers so the resulting second path event does
  # not create a duplicate notification. A later identical run still notifies
  # once the short time window has elapsed.
  signature=$(
    {
      printf '%s\n' "$outcome"
      printf '%s\n' "$clean_log" | grep -E 'Updating Host|Update only LXC/VM|--- PVE UPDATE ---|Updating LXC|Updating VM|Finished, with errors\.|Error during update --- Exit Code:|Finished, all updates done\.' || true
    } | hash_text
  )
  now=$(date +%s)
  previous_signature=$(state_read "${STATE_DIR}/manual-signature")
  previous_time=$(state_read "${STATE_DIR}/manual-time")
  previous_time=${previous_time:-0}

  if [[ "$signature" == "$previous_signature" ]] && ((now - previous_time < MANUAL_DEDUPE_SECONDS)); then
    return 0
  fi

  send_ntfy "$title" "$tags" "$details"
  atomic_write "${STATE_DIR}/manual-signature" "$signature"
  atomic_write "${STATE_DIR}/manual-time" "$now"

  # Revalidate upstream integration only after a terminal manual-run marker is
  # observed. This avoids health probes on every intermediate log write while
  # still catching self-update/interface changes immediately after a real run.
  run_health
}

usage() {
  cat <<'EOF'
Usage: ultimate-updater-notify <check|health|observe-manual>

  check           Run the accepted Ultimate Updater read-only inventory/status check and notify on state changes.
  health          Validate Ultimate Updater compatibility and companion scheduling health.
  observe-manual  Inspect the Ultimate Updater log and notify on completed operator-triggered runs.
EOF
}

main() {
  case "${1:-}" in
    check)
      run_check
      ;;
    health)
      run_health
      ;;
    observe-manual)
      observe_manual
      ;;
    -h|--help)
      usage
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
